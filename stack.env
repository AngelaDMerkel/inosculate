# Generic example for Compose frontends that use stack.env.
# Replace these with directories on the Docker host and grant UID/GID 568 access.
INGEST_PATH=./ingest
MOVIES_PATH=./movies
TELEVISION_PATH=./television
APP_DATA_PATH=./data
INOSCULATE_IMAGE=ghcr.io/angeladmerkel/inosculate:latest

WEB_PORT=8787

REMUX_CONCURRENCY=1
PROBE_CONCURRENCY=3
PREVIEW_CONCURRENCY=2
STABILITY_SECONDS=30
