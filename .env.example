# Directories on the Docker host. Relative paths resolve beside compose.yml.
# Create them and grant UID/GID 568 access before starting the services.
INGEST_PATH=./ingest
MOVIES_PATH=./movies
TELEVISION_PATH=./television
APP_DATA_PATH=./data

# Prefer an exact published version or digest for controlled upgrades.
# Before the first stable release, explicitly choose :dev or a prerelease tag.
INOSCULATE_IMAGE=ghcr.io/angeladmerkel/inosculate:latest

WEB_PORT=8787

REMUX_CONCURRENCY=1
PROBE_CONCURRENCY=3
PREVIEW_CONCURRENCY=2
STABILITY_SECONDS=30
