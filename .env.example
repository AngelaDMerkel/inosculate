# These must be paths on the TrueNAS/Docker host, not /Volumes paths from a Mac.
# Find the exact paths in TrueNAS under Shares > SMB > Edit > Path.
INGEST_PATH=/mnt/YOUR_POOL/YOUR_DATASET/torrent-vpn-temp
MOVIES_PATH=/mnt/YOUR_POOL/YOUR_DATASET/Movies
TELEVISION_PATH=/mnt/YOUR_POOL/YOUR_DATASET/Television
APP_DATA_PATH=/mnt/YOUR_POOL/apps/inosculate

WEB_PORT=8787
INOSCULATE_TAG=0.5.0
MAKEMKV_KEY=
MAKEMKV_VERSION=1.18.4

REMUX_CONCURRENCY=1
PROBE_CONCURRENCY=3
PREVIEW_CONCURRENCY=2
STABILITY_SECONDS=30
